Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates git python3-dev python3-venv make cmake g++ gfortran libopenmpi-dev openmpi-bin libblas-dev liblapack-dev
    python3 -m venv /opt/ns
    export PATH=/opt/ns/bin:/usr/local/cuda/bin:$PATH
    pip install 'pip<26' setuptools wheel 'Cython>=3,<3.1' numpy==1.26.4 scipy==1.13.1 scikit-fem==12.0.2 pytest
    pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu
    git clone --depth 1 --branch v3.22.5 https://gitlab.com/petsc/petsc.git /tmp/ns-petsc
    cd /tmp/ns-petsc
    export PETSC_DIR=/tmp/ns-petsc PETSC_ARCH=arch-l4
    export OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
    ./configure --prefix=/opt/petsc --with-debugging=0 --with-shared-libraries=1 \
        --with-cc=mpicc --with-cxx=mpicxx --with-fc=mpif90 --with-cuda=1 \
        --with-cuda-arch=89 --download-hypre --with-make-np=4
    make -j4 all
    make install
    unset PETSC_ARCH
    export PETSC_DIR=/opt/petsc
    grep -q '^#define PETSC_HAVE_HYPRE_DEVICE 1$' /opt/petsc/include/petscconf.h
    pip install --no-build-isolation ./src/binding/petsc4py
    python -c 'from petsc4py import PETSc; assert PETSc.Sys.hasExternalPackage("cuda") and PETSc.Sys.hasExternalPackage("hypre")'
    cd /
    rm -rf /tmp/ns-petsc /root/.cache/pip /var/lib/apt/lists/*

%environment
    export PATH=/opt/ns/bin:$PATH
    export PETSC_DIR=/opt/petsc
    export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
